<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="기말감사"
            android:textColor="@color/w_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/w_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cells"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
            <TextView android:id="@+id/k0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_muted" android:textSize="11sp" />
            <TextView android:id="@+id/v0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_ink" android:textSize="19sp" android:textStyle="bold" android:fontFamily="monospace" />
            <ProgressBar android:id="@+id/p0" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="2dp" android:progressDrawable="@drawable/widget_progress" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
            <TextView android:id="@+id/k1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_muted" android:textSize="11sp" />
            <TextView android:id="@+id/v1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_ink" android:textSize="19sp" android:textStyle="bold" android:fontFamily="monospace" />
            <ProgressBar android:id="@+id/p1" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="2dp" android:progressDrawable="@drawable/widget_progress" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
            <TextView android:id="@+id/k2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_muted" android:textSize="11sp" />
            <TextView android:id="@+id/v2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_ink" android:textSize="19sp" android:textStyle="bold" android:fontFamily="monospace" />
            <ProgressBar android:id="@+id/p2" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="2dp" android:progressDrawable="@drawable/widget_progress" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/k3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_muted" android:textSize="11sp" />
            <TextView android:id="@+id/v3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/w_ink" android:textSize="19sp" android:textStyle="bold" android:fontFamily="monospace" />
            <ProgressBar android:id="@+id/p3" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="2dp" android:progressDrawable="@drawable/widget_progress" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/alert_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_alert_bg"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign-off 급함  "
            android:textColor="@color/w_danger"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/alert_names"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/w_ink"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ok_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_ok_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/w_ok"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
